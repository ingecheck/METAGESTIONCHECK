{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, company information, and license details",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID of the user" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "displayName": { "type": "string", "description": "Full name of the user" },
        "role": { "type": "string", "enum": ["admin", "postor", "evaluador"], "description": "Access role" },
        "companyName": { "type": "string", "description": "Company name" },
        "ruc": { "type": "string", "maxLength": 11, "description": "11-digit Peruvian RUC" },
        "licenseKey": { "type": "string", "description": "License activation key" },
        "status": { "type": "string", "enum": ["active", "suspended", "expired"], "description": "Account status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "expiresAt": { "type": "string", "description": "Expiration date" },
        "maxTenders": { "type": "number", "description": "Max allowed tenders" },
        "currentTendersCount": { "type": "number", "description": "Tenders created" },
        "issuedBy": { "type": "string", "description": "Admin who issued the account" }
      },
      "required": ["userId", "email", "role", "status"]
    },
    "TenderProposal": {
      "title": "TenderProposal",
      "description": "OSCE Tender proposal created by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Proposal ID" },
        "ownerId": { "type": "string", "description": "User ID of creator" },
        "nomenclatura": { "type": "string", "description": "Tender nomenclature" },
        "entidadConvocante": { "type": "string", "description": "Public entity" },
        "objetoContratacion": { "type": "string", "description": "Goods/Services/Works" },
        "tipoProcedimiento": { "type": "string", "description": "Procedure type" },
        "valorEstimadoReferencial": { "type": "string", "description": "Reference value" },
        "plazoEjecucion": { "type": "string", "description": "Execution term" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update" }
      },
      "required": ["id", "ownerId", "nomenclatura"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and permissions managed by Admin"
    },
    "/proposals/{proposalId}": {
      "schema": "TenderProposal",
      "description": "Tender proposals saved by users"
    }
  }
}
